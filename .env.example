# Copy to .env and fill every value. Placeholders only — never commit real values.
NODE_ENV=development
PORT=4000

# MySQL connection (Prisma). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://placeholder:placeholder@127.0.0.1:3306/lead_platform

# Auth
JWT_SECRET=replace-with-32-byte-random-hex
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password

# Shared secret between the Next.js edge handler and this API (constant-time compared)
INTERNAL_API_TOKEN=replace-with-random-token

# Public rate limit: submissions per minute per source IP (default 30)
PUBLIC_RATE_LIMIT_PER_MIN=30

# Worker identity written to heartbeat rows
WORKER_ID=worker-1

# Feature flags
CONFIG_CACHE=false
INLINE_WORKER=false
JWT_EXPIRES_IN=24h
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5
